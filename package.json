{
  "name": "memoria-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Memoria conversacional privada basada en exportaciones reales de WhatsApp.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "parse:summary": "node packages/whatsapp-parser/src/cli.js summary",
    "media:check": "node packages/whatsapp-parser/src/cli.js media-check",
    "ingest": "node packages/whatsapp-parser/src/cli.js ingest",
    "audio:inventory": "node packages/whatsapp-parser/src/cli.js audio-inventory",
    "transcription:batch": "node packages/whatsapp-parser/src/cli.js transcription-batch",
    "transcription:run-local": ".venv\\Scripts\\python.exe scripts\\transcribe-faster-whisper.py",
    "transcription:compare": "node scripts/compare-transcription-runs.js",
    "memory:build": "node packages/whatsapp-parser/src/cli.js memory-build",
