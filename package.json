{
  "name": "memoria-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Memoria conversacional privada basada en exportaciones reales de WhatsApp.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "parse:summary": "node packages/whatsapp-parser/src/cli.js summary",
    "media:check": "node packages/whatsapp-parser/src/cli.js media-check",
    "ingest": "node packages/whatsapp-parser/src/cli.js ingest",
    "audio:inventory": "node packages/whatsapp-parser/src/cli.js audio-inventory",
    "transcription:batch": "node packages/whatsapp-parser/src/cli.js transcription-batch",
    "transcription:run-local": ".venv\\Scripts\\python.exe scripts\\transcribe-faster-whisper.py",
    "transcription:compare": "node scripts/compare-transcription-runs.js",
    "facebook:import": "powershell -ExecutionPolicy Bypass -File .\\scripts\\import-facebook-messages.ps1",
    "assertion:add": "node scripts/add-user-assertion.js",
    "assertion:build": "node scripts/build-user-assertion-memories.js",
    "memory:build": "node packages/whatsapp-parser/src/cli.js memory-build",
    "memory:merge": "node scripts/merge-memories.js",
    "memory:chunk": "node packages/whatsapp-parser/src/cli.js memory-chunk",
    "persona:style": "node scripts/build-style-profile.js",
    "persona:deep": "node scripts/build-deep-profile.js",
    "rag:embed": ".venv\\Scripts\\python.exe scripts\\embed-memory-chunks.py",
    "rag:search": ".venv\\Scripts\\python.exe scripts\\search-memory.py",
    "answer:draft": ".venv\\Scripts\\python.exe scripts\\answer-memory.py",
    "quality:evaluate": "node scripts/evaluate-answer-quality.js",
    "chat:local": "node scripts/local-chat-server.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  }
}
